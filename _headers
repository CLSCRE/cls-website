# Cache-Control rules for Cloudflare Workers Static Assets (clscre.com)
# Default asset behavior is "public, max-age=0, must-revalidate" (effectively
# no edge caching), which is why the site's Cloudflare cache hit rate was
# reading ~47% (site health audit, 2026-08-25). These rules give the CDN
# something to actually cache while keeping content freshness intact.
#
# CSS/JS below are always referenced with a `?v=<hash>` cache-busting query
# string in the generated HTML (see e.g. financing/*.html), so a content
# change produces a brand-new URL and the immutable cache never serves stale
# code — safe to cache hard.

/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Deal photos, team photos, etc. aren't versioned, so keep a moderate window
# with stale-while-revalidate rather than a hard immutable cache.
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/videos/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/favicon-16x16.png
  Cache-Control: public, max-age=604800

/favicon-32x32.png
  Cache-Control: public, max-age=604800

/favicon.ico
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

# HTML pages are regenerated frequently by the programmatic pipeline, so keep
# browser caching short (max-age=0, always revalidate) but let the edge hold
# a copy for 30 minutes with a 10-minute stale-while-revalidate window — this
# is what actually raises the Cloudflare cache hit rate, since the vast
# majority of requests are HTML across ~7,300 sitemap pages.
/*.html
  Cache-Control: public, max-age=0, s-maxage=1800, stale-while-revalidate=600

/*.xml
  Cache-Control: public, max-age=300, s-maxage=1800

/robots.txt
  Cache-Control: public, max-age=3600
